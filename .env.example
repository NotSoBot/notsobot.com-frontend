# Base path the API is mounted on. In production nginx serves notsobot.api under /api on the same origin.
VITE_API_BASE=/api

# Show the "Log in with Discord" UI and the dashboard link in the navbar. Production builds leave it off unless this
# is true, so set it on the machine that runs `npm run deploy` (dev has it on by default).
VITE_AUTH_ENABLED=true

# Umami analytics, only needed without the worker (dev, `vite preview`); the worker adds the script in production.
# Leave empty to disable. e.g. https://oasis.notsobot.com/drink.js and the website id from Umami's settings
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# Dev only: where `npm run dev` proxies /api requests to.
# Point this at your local nginx (e.g. http://localhost) when running notsobot.api with docker compose.
VITE_DEV_API_PROXY=https://notsobot.com

# Dev only: serve the dashboard's /users/@me/* routes (docs/dashboard-api.md) from in-memory fixtures and fake a
# logged-in user, for working on the dashboard before notsobot.api has those endpoints. Ignored by `npm run build`.
# e.g. `VITE_DASHBOARD_MOCKS=true npm run dev -- --port 5174`
VITE_DASHBOARD_MOCKS=false

# Deploying with Wrangler on a machine without a browser (instead of `npx wrangler login`). Wrangler reads these
# from .env itself; they never reach the site (only VITE_* variables are built into it). Keep this file private:
# it's gitignored, and `chmod 600 .env` on shared servers.
# Token: Cloudflare dashboard -> My Profile -> API Tokens -> "Edit Cloudflare Workers" template, scoped to the
# notsobot.com account and zone. Account ID: right side of the notsobot.com overview page.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
